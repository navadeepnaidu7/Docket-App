<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks cleartext HTTP by default, which silently breaks poster loading against a
  local backend (http://10.0.2.2:8080 from the emulator) with no visible error.

  The exception is scoped to loopback addresses only, so release traffic to the real API stays
  TLS-only. Do not widen this to cleartextTrafficPermitted on the base config.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator's alias for the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
